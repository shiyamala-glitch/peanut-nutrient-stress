        "\"\"\"\n",
        "AI-based Plant Nutrient Stress Prediction (Peanut + Soil) using IoT sensor data\n",
        "===============================================================================\n",
        "HOW TO RUN (Google Colab - easiest for beginners):\n",
        "  1. Go to colab.research.google.com -> New notebook\n",
        "  2. Paste this whole file in one cell and run it\n",
        "  3. It will ask you to upload a CSV.\n",
        "       - Upload your own sensor/dataset CSV, OR\n",
        "       - Click Cancel / don't choose a file -> it creates a sample dataset automatically\n",
        "  4. Graphs appear on screen and are saved in the folder \"output/\"\n",
        "\n",
        "HOW TO RUN (Laptop):\n",
        "  pip install pandas numpy scikit-learn matplotlib seaborn\n",
        "  python peanut_stress_prediction.py                 (makes sample data)\n",
        "  python peanut_stress_prediction.py mydata.csv      (uses your CSV)\n",
        "\n",
        "CSV columns it understands (names are case-insensitive; extra ones are fine):\n",
        "  N, P, K, pH, EC, Ca, soil_moisture, soil_temp, air_temp, humidity,\n",
        "  light, rainfall, timestamp (optional)\n",
        "  stress_class (optional label). If missing, labels are made using\n",
        "  peanut agronomy threshold rules.\n",
        "\"\"\"\n",
        "import os, sys, warnings\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib\n",
        "if \"google.colab\" not in sys.modules and not os.environ.get(\"DISPLAY\") and os.name != \"nt\":\n",
        "    matplotlib.use(\"Agg\")\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
        "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import accuracy_score, f1_score, confusion_matrix, classification_report\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "OUT = \"output\"\n",
        "os.makedirs(OUT, exist_ok=True)\n",
        "rng = np.random.default_rng(42)\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 1: Peanut agronomy rules (approximate, adjust with TNAU/ICRISAT values)\n",
        "# --------------------------------------------------------------------------\n",
        "LIMITS = {\"N\": 40, \"P\": 25, \"K\": 40, \"Ca\": 300}   # below this = deficient\n",
        "PH_LOW, PH_HIGH, PH_IRON = 6.0, 7.0, 7.3           # ideal range; above 7.3 = iron stress\n",
        "\n",
        "RECOMMEND = {\n",
        "    \"Healthy\": \"Nutrient levels are fine. Continue regular monitoring.\",\n",
        "    \"N_deficiency\": \"Nitrogen low: apply urea / ammonium sulphate in split doses; check Rhizobium nodulation.\",\n",
        "    \"P_deficiency\": \"Phosphorus low: apply single super phosphate (SSP) as basal dose.\",\n",
        "    \"K_deficiency\": \"Potassium low: apply muriate of potash (MOP).\",\n",
        "    \"Ca_deficiency\": \"Calcium low (pod filling): apply gypsum at flowering / pegging stage.\",\n",
        "    \"Fe_stress\": \"High pH causing iron stress: apply ferrous sulphate (0.5%) foliar spray, add organic matter.\",\n",
        "}\n",
        "\n",
        "def rule_label(r):\n",
        "    \"\"\"Label one row using threshold rules (used when your CSV has no label).\"\"\"\n",
        "    if \"pH\" in r and r[\"pH\"] > PH_IRON: return \"Fe_stress\"\n",
        "    for nutrient, name in [(\"N\", \"N_deficiency\"), (\"P\", \"P_deficiency\"),\n",
        "                           (\"K\", \"K_deficiency\"), (\"Ca\", \"Ca_deficiency\")]:\n",
        "        if nutrient in r and pd.notna(r[nutrient]) and r[nutrient] < LIMITS[nutrient]:\n",
        "            return name\n",
        "    return \"Healthy\"\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 2: Sample IoT-style dataset generator (used if you upload nothing)\n",
        "# --------------------------------------------------------------------------\n",
        "def make_sample_data(n=1800):\n",
        "    classes = list(RECOMMEND.keys())\n",
        "    rows = []\n",
        "    for i in range(n):\n",
        "        c = classes[i % len(classes)]\n",
        "        N, P, K = rng.normal(70, 15), rng.normal(45, 10), rng.normal(75, 15)\n",
        "        Ca, pH = rng.normal(500, 80), rng.normal(6.5, 0.3)\n",
        "        if c == \"N_deficiency\":  N = rng.normal(22, 8)\n",
        "        if c == \"P_deficiency\":  P = rng.normal(12, 5)\n",
        "        if c == \"K_deficiency\":  K = rng.normal(22, 8)\n",
        "        if c == \"Ca_deficiency\": Ca = rng.normal(170, 50)\n",
        "        if c == \"Fe_stress\":     pH = rng.normal(7.8, 0.3)\n",
        "        rows.append(dict(\n",
        "            N=N, P=P, K=K, pH=pH, Ca=Ca,\n",
        "            EC=rng.normal(1.1, 0.3),\n",
        "            soil_moisture=rng.normal(45, 10),\n",
        "            soil_temp=rng.normal(29, 3),\n",
        "            air_temp=rng.normal(32, 4),\n",
        "            humidity=rng.normal(65, 10),\n",
        "            light=rng.normal(650, 120),\n",
        "            rainfall=abs(rng.normal(3, 4)),\n",
        "            stress_class=c))\n",
        "    df = pd.DataFrame(rows).sample(frac=1, random_state=1).reset_index(drop=True)\n",
        "    df.insert(0, \"timestamp\", pd.date_range(\"2026-06-01\", periods=n, freq=\"30min\"))\n",
        "    # label noise (5%) + missing values (3%) so it behaves like real sensor data\n",
        "    flip = rng.random(n) < 0.05\n",
        "    df.loc[flip, \"stress_class\"] = rng.choice(classes, flip.sum())\n",
        "    for col in [\"N\", \"P\", \"K\", \"soil_moisture\", \"humidity\"]:\n",
        "        df.loc[rng.random(n) < 0.03, col] = np.nan\n",
        "    df = df.clip(lower=0, axis=1, numeric_only=True) if False else df\n",
        "    return df\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 3: Load data (upload / argument / generate)\n",
        "# --------------------------------------------------------------------------\n",
        "def load_data():\n",
        "    path = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1].endswith(\".csv\") else None\n",
        "    if path is None and \"google.colab\" in sys.modules:\n",
        "        try:\n",
        "            from google.colab import files\n",
        "            print(\"Upload your CSV (or cancel to use sample data)...\")\n",
        "            up = files.upload()\n",
        "            if up: path = list(up.keys())[0]\n",
        "        except Exception:\n",
        "            pass\n",
        "    if path and os.path.exists(path):\n",
        "        print(f\"Using your dataset: {path}\")\n",
        "        return pd.read_csv(path)\n",
        "    print(\"No CSV given -> creating sample peanut dataset.\")\n",
        "    df = make_sample_data()\n",
        "    df.to_csv(f\"{OUT}/sample_peanut_dataset.csv\", index=False)\n",
        "    return df\n",
        "\n",
        "df = load_data()\n",
        "df.columns = [c.strip() for c in df.columns]\n",
        "alias = {c.lower(): c for c in df.columns}\n",
        "for std in [\"N\", \"P\", \"K\", \"pH\", \"EC\", \"Ca\"]:           # fix case, e.g. ph -> pH\n",
        "    if std.lower() in alias and std not in df.columns:\n",
        "        df = df.rename(columns={alias[std.lower()]: std})\n",
        "if \"timestamp\" in alias: df = df.rename(columns={alias[\"timestamp\"]: \"timestamp\"})\n",
        "print(\"\\nDataset shape:\", df.shape)\n",
        "print(df.head())\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 4: Cleaning + preprocessing\n",
        "# --------------------------------------------------------------------------\n",
        "if \"stress_class\" not in df.columns:\n",
        "    print(\"\\nNo 'stress_class' column found -> labelling using peanut threshold rules.\")\n",
        "    df[\"stress_class\"] = df.apply(rule_label, axis=1)\n",
        "\n",
        "has_time = \"timestamp\" in df.columns\n",
        "if has_time: df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], errors=\"coerce\")\n",
        "num_cols = [c for c in df.select_dtypes(include=np.number).columns]\n",
        "df = df.drop_duplicates()\n",
        "df[num_cols] = df[num_cols].fillna(df[num_cols].median())           # missing values\n",
        "for c in num_cols:                                                   # clip outliers (1.5 IQR)\n",
        "    q1, q3 = df[c].quantile([.25, .75]); iqr = q3 - q1\n",
        "    df[c] = df[c].clip(q1 - 3 * iqr, q3 + 3 * iqr)\n",
        "print(\"\\nCleaned. Missing values left:\", int(df[num_cols].isna().sum().sum()))\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 5: Graphs - data exploration\n",
        "# --------------------------------------------------------------------------\n",
        "def save(name):\n",
        "    plt.tight_layout(); plt.savefig(f\"{OUT}/{name}.png\", dpi=150); plt.show(); plt.close()\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "df[\"stress_class\"].value_counts().plot(kind=\"bar\", color=\"seagreen\")\n",
        "plt.title(\"Class distribution (stress types)\"); plt.ylabel(\"Samples\"); save(\"1_class_distribution\")\n",
        "\n",
        "plt.figure(figsize=(9, 7))\n",
        "sns.heatmap(df[num_cols].corr(), annot=True, fmt=\".2f\", cmap=\"YlGn\", annot_kws={\"size\": 7})\n",
        "plt.title(\"Feature correlation\"); save(\"2_correlation_heatmap\")\n",
        "\n",
        "if has_time:\n",
        "    nut = [c for c in [\"N\", \"P\", \"K\"] if c in df.columns]\n",
        "    d = df.sort_values(\"timestamp\").set_index(\"timestamp\")[nut].resample(\"1D\").mean()\n",
        "    d.plot(figsize=(9, 4)); plt.title(\"Soil nutrient trend over time (daily mean)\")\n",
        "    plt.ylabel(\"Level\"); save(\"3_nutrient_trend\")\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 6: MODEL A - Soil prediction (soil fertility class from soil sensors)\n",
        "# --------------------------------------------------------------------------\n",
        "soil_cols = [c for c in [\"N\", \"P\", \"K\", \"pH\", \"EC\", \"Ca\", \"soil_moisture\", \"soil_temp\"] if c in df.columns]\n",
        "def fertility(r):\n",
        "    score = sum([r.get(\"N\", 99) >= LIMITS[\"N\"], r.get(\"P\", 99) >= LIMITS[\"P\"],\n",
        "                 r.get(\"K\", 99) >= LIMITS[\"K\"], PH_LOW <= r.get(\"pH\", 6.5) <= PH_HIGH])\n",
        "    return \"High\" if score == 4 else \"Medium\" if score >= 2 else \"Low\"\n",
        "df[\"soil_fertility\"] = df.apply(fertility, axis=1)\n",
        "\n",
        "Xs_tr, Xs_te, ys_tr, ys_te = train_test_split(df[soil_cols], df[\"soil_fertility\"],\n",
        "                                              test_size=0.2, random_state=42, stratify=df[\"soil_fertility\"])\n",
        "soil_model = RandomForestClassifier(n_estimators=200, random_state=42).fit(Xs_tr, ys_tr)\n",
        "soil_pred = soil_model.predict(Xs_te)\n",
        "print(\"\\n=== SOIL MODEL (fertility: Low/Medium/High) ===\")\n",
        "print(\"Accuracy:\", round(accuracy_score(ys_te, soil_pred), 3))\n",
        "labs = sorted(df[\"soil_fertility\"].unique())\n",
        "plt.figure(figsize=(5, 4))\n",
        "sns.heatmap(confusion_matrix(ys_te, soil_pred, labels=labs), annot=True, fmt=\"d\",\n",
        "            xticklabels=labs, yticklabels=labs, cmap=\"Blues\")\n",
        "plt.title(\"Soil fertility - confusion matrix\"); plt.xlabel(\"Predicted\"); plt.ylabel(\"Actual\")\n",
        "save(\"4_soil_confusion_matrix\")\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 7: MODEL B - Peanut plant nutrient stress (all sensors)\n",
        "# --------------------------------------------------------------------------\n",
        "feat = [c for c in num_cols if c != \"soil_fertility\"]\n",
        "le = LabelEncoder(); y = le.fit_transform(df[\"stress_class\"])\n",
        "X_tr, X_te, y_tr, y_te = train_test_split(df[feat], y, test_size=0.2, random_state=42, stratify=y)\n",
        "sc = StandardScaler().fit(X_tr)\n",
        "\n",
        "models = {\n",
        "    \"Logistic Regression\": LogisticRegression(max_iter=1000),\n",
        "    \"Random Forest\": RandomForestClassifier(n_estimators=300, random_state=42),\n",
        "    \"Gradient Boosting\": GradientBoostingClassifier(random_state=42),\n",
        "}\n",
        "results = {}\n",
        "for name, m in models.items():\n",
        "    m.fit(sc.transform(X_tr), y_tr)\n",
        "    p = m.predict(sc.transform(X_te))\n",
        "    results[name] = (accuracy_score(y_te, p), f1_score(y_te, p, average=\"weighted\"), p)\n",
        "    print(f\"{name:22s} Accuracy={results[name][0]:.3f}  F1={results[name][1]:.3f}\")\n",
        "\n",
        "best = max(results, key=lambda k: results[k][1])\n",
        "print(f\"\\nBest model: {best}\")\n",
        "print(classification_report(y_te, results[best][2], target_names=le.classes_))\n",
        "\n",
        "# graph: model comparison\n",
        "plt.figure(figsize=(7, 4))\n",
        "cmp = pd.DataFrame({k: v[:2] for k, v in results.items()}, index=[\"Accuracy\", \"F1\"]).T\n",
        "cmp.plot(kind=\"bar\", ax=plt.gca(), color=[\"#2e8b57\", \"#f4a460\"]); plt.ylim(0, 1.05)\n",
        "plt.title(\"Model comparison\"); plt.xticks(rotation=15); save(\"5_model_comparison\")\n",
        "\n",
        "# graph: confusion matrix\n",
        "plt.figure(figsize=(7, 6))\n",
        "sns.heatmap(confusion_matrix(y_te, results[best][2]), annot=True, fmt=\"d\", cmap=\"Greens\",\n",
        "            xticklabels=le.classes_, yticklabels=le.classes_)\n",
        "plt.title(f\"Peanut stress - confusion matrix ({best})\"); plt.xlabel(\"Predicted\"); plt.ylabel(\"Actual\")\n",
        "plt.xticks(rotation=30); save(\"6_stress_confusion_matrix\")\n",
        "\n",
        "# graph: feature importance (from Random Forest)\n",
        "rf = models[\"Random Forest\"]\n",
        "imp = pd.Series(rf.feature_importances_, index=feat).sort_values()\n",
        "plt.figure(figsize=(7, 5)); imp.plot(kind=\"barh\", color=\"darkgreen\")\n",
        "plt.title(\"Feature importance - what drives nutrient stress?\"); save(\"7_feature_importance\")\n",
        "\n",
        "# graph: predicted vs actual (first 100 test samples)\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(y_te[:100], \"o-\", label=\"Actual\", alpha=.7)\n",
        "plt.plot(results[best][2][:100], \"x--\", label=\"Predicted\", alpha=.7)\n",
        "plt.yticks(range(len(le.classes_)), le.classes_); plt.legend()\n",
        "plt.title(\"Predicted vs Actual (first 100 test samples)\"); save(\"8_predicted_vs_actual\")\n",
        "\n",
        "# --------------------------------------------------------------------------\n",
        "# STEP 8: Predictions + recommendations for every row -> CSV\n",
        "# --------------------------------------------------------------------------\n",
        "best_model = models[best]\n",
        "df[\"predicted_stress\"] = le.inverse_transform(best_model.predict(sc.transform(df[feat])))\n",
        "df[\"recommendation\"] = df[\"predicted_stress\"].map(RECOMMEND)\n",
        "df[\"soil_fertility_pred\"] = soil_model.predict(df[soil_cols])\n",
        "df.to_csv(f\"{OUT}/predictions_with_recommendations.csv\", index=False)\n",
        "\n",
        "print(\"\\n=== LATEST READINGS: PREDICTION + RECOMMENDATION ===\")\n",
        "print(df[[\"predicted_stress\", \"soil_fertility_pred\", \"recommendation\"]].tail(5).to_string(index=False))\n",
        "print(f\"\\nDONE. All graphs + predictions CSV saved in the '{OUT}/' folder.\")\n",
        "if \"google.colab\" in sys.modules:\n",
        "    print(\"In Colab: click the folder icon on the left -> output/ to download files.\")"
      ]
    }
  ]
}